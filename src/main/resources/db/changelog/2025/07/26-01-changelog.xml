<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1753533217579-1" author="vadim">
        <createTable tableName="image_cluster">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_image_cluster"/>
            </column>
            <column name="created_at" type="DATETIME"/>
        </createTable>
    </changeSet>
    <changeSet id="1753533217579-2" author="vadim">
        <createTable tableName="image_cluster_link">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_image_cluster_link"/>
            </column>
            <column name="cluster_id" type="BIGINT"/>
            <column name="image_id" type="BIGINT"/>
        </createTable>
    </changeSet>
    <changeSet id="1753533217579-3" author="vadim">
        <createTable tableName="images">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_images"/>
            </column>
            <column name="url" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1753533217579-4" author="vadim">
        <addForeignKeyConstraint baseColumnNames="cluster_id" baseTableName="image_cluster_link"
                                 constraintName="FK_IMAGE_CLUSTER_LINK_ON_CLUSTER" referencedColumnNames="id"
                                 referencedTableName="image_cluster"/>
    </changeSet>
    <changeSet id="1753533217579-5" author="vadim">
        <addForeignKeyConstraint baseColumnNames="image_id" baseTableName="image_cluster_link"
                                 constraintName="FK_IMAGE_CLUSTER_LINK_ON_IMAGE" referencedColumnNames="id"
                                 referencedTableName="images"/>
    </changeSet>

</databaseChangeLog>